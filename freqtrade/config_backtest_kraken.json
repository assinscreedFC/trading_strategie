{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "_comment": "Config BACKTEST — 200 USDT, Kraken fees, spot long only",
    "trading_mode": "spot",
    "margin_mode": "",
    "max_open_trades": 8,
    "stake_currency": "USDT",
    "stake_amount": 20,
    "tradable_balance_ratio": 0.95,
    "dry_run": true,
    "dry_run_wallet": 200,
    "cancel_open_orders_on_exit": false,
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {"timeout": 60000, "enableRateLimit": true},
        "ccxt_async_config": {"timeout": 60000},
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT",
            "SOL/USDT"
        ],
        "pair_blacklist": [
            ".*DOWN/USDT",
            ".*UP/USDT",
            ".*BEAR/USDT",
            ".*BULL/USDT"
        ]
    },
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "order_types": {
        "entry": "limit",
        "exit": "limit",
        "emergency_exit": "market",
        "force_entry": "market",
        "force_exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": true,
        "stoploss_on_exchange_interval": 60
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "internals": {
        "process_throttle_secs": 5,
        "heartbeat_interval": 60
    },
    "initial_state": "running",
    "force_entry_enable": false,
    "bot_name": "backtest-kraken-100usdt"
}
