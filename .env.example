# ══════════════════════════════════════════════════════════════
# anis solidscale — Elite Spot Trading Suite
# FICHIER : .env.example
# COPIER CE FICHIER VERS .env ET REMPLIR LES VALEURS
# ══════════════════════════════════════════════════════════════

# ── TELEGRAM (partagé par toutes les stratégies) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── BITGET (exchange principal) ──
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSWORD=

# ── MEXC (fees les plus bas : 0% maker / 0.05% taker) ──
MEXC_API_KEY=
MEXC_API_SECRET=

# ── BLOCKCHAIN / ON-CHAIN ──
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETH_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETH_PRIVATE_KEY=
ETH_WALLET_ADDRESS=

# ── DEXSCREENER (pas de clé requise, mais URL configurable) ──
DEXSCREENER_API_URL=https://api.dexscreener.com/latest/dex
